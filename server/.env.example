PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/lingohub
# Optional AI requirement drafting. The API key stays on the server.
AI_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# REQUIRED in production, 32+ random chars:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES=12h
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse-proxy hops in front of the app (nginx/ALB/Render = 1). Leave unset if clients connect directly,
# otherwise X-Forwarded-For can be spoofed to dodge rate limits.
# TRUST_PROXY=1
PLATFORM_FEE=0.15
MAX_CONCURRENT_TICKETS=5
ROUTING_INTERVAL_MS=20000
# Optional one-time admin bootstrap (set both values, run `npm run admin:create`, then remove the password).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
